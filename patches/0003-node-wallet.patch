+package org.permaweb.andee
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.os.Bundle
+import android.text.InputType
+import android.view.Gravity
+import android.view.View
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import org.json.JSONObject
+
+/**
+ * Node wallet: the AR held by the AndEE node identity.
+ *
+ * Read-only until the user asks for a transfer; signing uses the app-private HyperBEAM key
+ * ([AndeePaths.nodeWalletFile]) and the signed transaction is posted straight to the gateway.
+ * Nothing is broadcast without the confirmation dialog.
+ */
+class NodeWalletActivity : Activity() {
+    private val gateway = "https://arweave.net"
+    private val density by lazy { resources.displayMetrics.density }
+
+    private lateinit var balanceView: TextView
+    private lateinit var addressView: TextView
+    private lateinit var recipientInput: EditText
+    private lateinit var amountInput: EditText
+    private lateinit var beneficiaryInput: EditText
+    private lateinit var statusView: TextView
+    private lateinit var sendButton: Button
+
+    private var wallet: ArweaveWallet? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setBackgroundColor(AndeePalette.background)
+            setPadding(dp(22f), dp(28f), dp(22f), dp(28f))
+        }
+
+        root.addView(
+            textButton("← NODE WALLET") { finish() },
+            LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.WRAP_CONTENT,
+                LinearLayout.LayoutParams.WRAP_CONTENT,
+            ),
+        )
+        root.addView(label("AR balance held by this node", accent = true, size = 10f))
+        balanceView = label("…", size = 30f, color = AndeePalette.ink)
+        root.addView(balanceView)
+        addressView = label("", size = 9f, color = AndeePalette.inkMuted)
+        root.addView(addressView)
+
+        root.addView(divider())
+        root.addView(label("SEND AR TO A WALLET", accent = true, size = 10f))
+        root.addView(label("Transfer is signed by the node key and posted to ${gateway.replace("https://", "")}.", size = 9f, color = AndeePalette.inkMuted))
+        recipientInput = input("Recipient address", InputType.TYPE_CLASS_TEXT)
+        root.addView(recipientInput)
+        amountInput = input("Amount in AR", InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL)
+        root.addView(amountInput)
+        sendButton = primaryButton("SEND") { confirmSend() }
+        root.addView(sendButton)
+
+        root.addView(divider())
+        root.addView(label("BUNDLER BENEFICIARY", accent = true, size = 10f))
+        root.addView(
+            label(
+                "Where the node's bundling income is settled. Staged for the next boot; tap APPLY & CLOSE on the node screen to restart with it.",
+                size = 9f,
+                color = AndeePalette.inkMuted,
+            ),
+        )
+        beneficiaryInput = input("Beneficiary address (defaults to the sender)", InputType.TYPE_CLASS_TEXT)
+        root.addView(beneficiaryInput)
+        root.addView(primaryButton("STAGE FOR NEXT BOOT") { stageBeneficiary() })
+
+        root.addView(divider())
+        statusView = label("", size = 10f, color = AndeePalette.inkMuted)
+        root.addView(statusView)
+
+        setContentView(
+            ScrollView(this).apply {
+                setBackgroundColor(AndeePalette.background)
+                addView(root)
+            },
+        )
+
+        loadWallet()
+        refreshBalance()
+    }
+
+    private fun dp(value: Float): Int = (value * density).toInt().coerceAtLeast(1)
+
+    private fun label(
+        text: String,
+        accent: Boolean = false,
+        size: Float = 11f,
+        color: Int = AndeePalette.inkStrong,
+    ) = TextView(this).apply {
+        this.text = text
+        typeface = Typeface.MONOSPACE
+        textSize = size
+        setTextColor(if (accent) AndeePalette.accentBright else color)
+        setPadding(0, dp(6f), 0, dp(6f))
+    }
+
+    private fun divider() = View(this).apply {
+        setBackgroundColor(AndeePalette.panel)
+        layoutParams = LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT,
+            dp(1f),
+        ).apply { topMargin = dp(14f) }
+    }
+
+    private fun input(hintText: String, inputType: Int) = EditText(this).apply {
+        hint = hintText
+        typeface = Typeface.MONOSPACE
+        textSize = 12f
+        setTextColor(AndeePalette.ink)
+        setHintTextColor(AndeePalette.inkMuted)
+        setInputType(inputType)
+        background = GradientDrawable().apply {
+            cornerRadius = 0f
+            setColor(AndeePalette.backgroundDeep)
+            setStroke(dp(1f), AndeePalette.panel)
+        }
+        setPadding(dp(10f), dp(9f), dp(10f), dp(9f))
+        layoutParams = LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT,
+            LinearLayout.LayoutParams.WRAP_CONTENT,
+        ).apply { topMargin = dp(8f) }
+    }
+
+    private fun primaryButton(text: String, action: () -> Unit) = Button(this).apply {
+        this.text = text
+        typeface = Typeface.MONOSPACE
+        textSize = 12f
+        isAllCaps = false
+        setTextColor(AndeePalette.backgroundDeep)
+        background = GradientDrawable().apply {
+            cornerRadius = 0f
+            setColor(AndeePalette.accent)
+        }
+        layoutParams = LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT,
+            dp(44f),
+        ).apply { topMargin = dp(12f) }
+        setOnClickListener { action() }
+    }
+
+    private fun textButton(text: String, action: () -> Unit) = Button(this).apply {
+        this.text = text
+        typeface = Typeface.MONOSPACE
+        textSize = 11f
+        isAllCaps = false
+        setTextColor(AndeePalette.accentBright)
+        setBackgroundColor(Color.TRANSPARENT)
+        setPadding(0, 0, 0, 0)
+        gravity = Gravity.START
+        setOnClickListener { action() }
+    }
+
+    private fun loadWallet() {
+        val file = AndeePaths.nodeWalletFile(this)
+        wallet = try {
+            if (!file.isFile) null else ArweaveWallet.fromJwk(file.readText(Charsets.UTF_8))
+        } catch (e: Exception) {
+            setStatus("Node key tidak terbaca: ${e.message}")
+            null
+        }
+        val loaded = wallet
+        if (loaded == null) {
+            balanceView.text = "—"
+            addressView.text = "Belum ada identitas node di perangkat ini. Jalankan node dulu."
+            sendButton.isEnabled = false
+            return
+        }
+        addressView.text = loaded.address
+        beneficiaryInput.hint = "Beneficiary address (${loaded.address.take(6)}…${loaded.address.takeLast(4)})"
+    }
+
+    private fun refreshBalance() {
+        val loaded = wallet ?: return
+        balanceView.text = "…"
+        Thread {
+            val text = try {
+                val winston = ArweaveHttp.get("$gateway/wallet/${loaded.address}/balance").trim()
+                "${ArweaveTx.winstonToAr(winston)} AR"
+            } catch (e: Exception) {
+                "tidak tersedia"
+            }
+            runOnUiThread { balanceView.text = text }
+        }.start()
+    }
+
+    private fun setStatus(message: String) {
+        runOnUiThread { statusView.text = message }
+    }
+
+    private fun confirmSend() {
+        val loaded = wallet ?: return
+        val recipient = recipientInput.text.toString().trim()
+        val amount = amountInput.text.toString().trim()
+        if (!ArweaveTx.isAddress(recipient)) {
+            setStatus("Alamat tujuan harus 43 karakter base64url.")
+            return
+        }
+        if (recipient == loaded.address) {
+            setStatus("Tujuan sama dengan wallet node; pakai wallet lain.")
+            return
+        }
+        val quantity = try {
+            ArweaveTx.arToWinston(amount)
+        } catch (e: Exception) {
+            setStatus("Jumlah AR tidak valid.")
+            return
+        }
+        if (quantity.signum() <= 0) {
+            setStatus("Jumlah harus lebih dari 0.")
+            return
+        }
+        setStatus("Menghitung fee…")
+        Thread {
+            try {
+                val reward = ArweaveHttp.get("$gateway/price/0").trim()
+                val lastTx = ArweaveHttp.get("$gateway/tx_anchor").trim()
+                runOnUiThread {
+                    setStatus("")
+                    AlertDialog.Builder(this)
+                        .setTitle("Kirim ${ArweaveTx.winstonToAr(quantity.toString())} AR?")
+                        .setMessage(
+                            "Dari node ${loaded.address}\n" +
+                                "Ke $recipient\n" +
+                                "Fee jaringan ${ArweaveTx.winstonToAr(reward)} AR",
+                        )
+                        .setNegativeButton("Batal", null)
+                        .setPositiveButton("Kirim") { _, _ ->
+                            submit(loaded, recipient, quantity.toString(), reward, lastTx)
+                        }
+                        .show()
+                }
+            } catch (e: Exception) {
+                setStatus("Gagal menyiapkan transaksi: ${e.message}")
+            }
+        }.start()
+    }
+
+    private fun submit(
+        loaded: ArweaveWallet,
+        recipient: String,
+        quantity: String,
+        reward: String,
+        lastTx: String,
+    ) {
+        setStatus("Menandatangani…")
+        Thread {
+            try {
+                val data = ArweaveTx.signingData(
+                    format = ArweaveTx.FORMAT,
+                    owner = ArweaveTx.decode(loaded.modulusBase64Url),
+                    target = ArweaveTx.decode(recipient),
+                    quantity = quantity,
+                    reward = reward,
+                    lastTx = ArweaveTx.decode(lastTx),
+                    tags = emptyList(),
+                    dataSize = "0",
+                    dataRoot = ByteArray(0),
+                )
+                val signature = ArweaveTx.sign(loaded, data)
+                val id = ArweaveTx.transactionId(signature)
+                val body = ArweaveTx.transferBody(
+                    id = id,
+                    owner = loaded.modulusBase64Url,
+                    target = recipient,
+                    quantity = quantity,
+                    reward = reward,
+                    lastTx = lastTx,
+                    signature = ArweaveTx.encode(signature),
+                )
+                ArweaveHttp.postJson("$gateway/tx", body)
+                runOnUiThread {
+                    setStatus("Terkirim. TX $id")
+                    recipientInput.setText("")
+                    amountInput.setText("")
+                }
+                Thread.sleep(1500L)
+                refreshBalance()
+            } catch (e: Exception) {
+                setStatus("Gagal mengirim: ${e.message}")
+            }
+        }.start()
+    }
+
+    private fun stageBeneficiary() {
+        val loaded = wallet
+        val value = beneficiaryInput.text.toString().trim().ifEmpty { loaded?.address.orEmpty() }
+        if (!ArweaveTx.isAddress(value)) {
+            setStatus("Alamat beneficiary harus 43 karakter base64url.")
+            return
+        }
+        try {
+            val overlay = JSONObject().put("bundler-beneficiary", value)
+            AndeeBootConfigStore.stageNextBootConfig(this, overlay.toString())
+            setStatus("Beneficiary $value disiapkan. Tutup app lalu APPLY & CLOSE untuk restart node.")
+            Toast.makeText(this, "Menunggu APPLY & CLOSE", Toast.LENGTH_LONG).show()
+        } catch (e: Exception) {
+            setStatus("Gagal menyiapkan config: ${e.message}")
+        }
+    }
+}
