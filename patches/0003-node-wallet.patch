+++ b/arch/android/android/app/src/test/java/org/permaweb/andee/ArweaveTxTest.kt
@@ -0,0 +1,116 @@
+package org.permaweb.andee
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.math.BigInteger
+import java.security.KeyFactory
+import java.security.MessageDigest
+import java.security.Signature
+import java.security.spec.MGF1ParameterSpec
+import java.security.spec.PSSParameterSpec
+import java.security.spec.RSAPublicKeySpec
+
+/**
+ * The signing data must reproduce what the network accepted, so the fixture is a transfer that
+ * is already mined: the deep hash has to match, and the recorded signature has to verify against
+ * the recorded owner key. Kept as key=value so the test needs no JSON parser.
+ */
+class ArweaveTxTest {
+    private val fixture: Map<String, String> by lazy {
+        val text = javaClass.getResourceAsStream("/arweave/mainnet-transfer.properties")!!
+            .use { it.readBytes().toString(Charsets.UTF_8) }
+        text.lineSequence()
+            .map { it.trim() }
+            .filter { it.isNotEmpty() && !it.startsWith("#") }
+            .associate { line ->
+                val index = line.indexOf('=')
+                line.substring(0, index) to line.substring(index + 1)
+            }
+    }
+
+    private fun field(name: String) = requireNotNull(fixture[name]) { "fixture missing $name" }
+
+    private fun publicKey() = KeyFactory.getInstance("RSA").generatePublic(
+        RSAPublicKeySpec(
+            BigInteger(1, ArweaveTx.decode(field("owner"))),
+            BigInteger.valueOf(65537),
+        ),
+    )
+
+    private fun verifier(data: ByteArray) = Signature.getInstance("RSASSA-PSS").apply {
+        setParameter(PSSParameterSpec("SHA-256", "MGF1", MGF1ParameterSpec.SHA256, 32, 1))
+        initVerify(publicKey())
+        update(data)
+    }
+
+    private fun signingDataForFixture(): ByteArray = ArweaveTx.signingData(
+        format = field("format").toInt(),
+        owner = ArweaveTx.decode(field("owner")),
+        target = ArweaveTx.decode(field("target")),
+        quantity = field("quantity"),
+        reward = field("reward"),
+        lastTx = ArweaveTx.decode(field("last_tx")),
+        tags = emptyList(),
+        dataSize = field("data_size"),
+        dataRoot = ArweaveTx.decode(field("data_root")),
+    )
+
+    @Test
+    fun signingDataMatchesTheMinedTransfer() {
+        val expected = "795740d52812125518f98868cdbdb802e05f8665723c5b825183ef73dbb931f8" +
+            "28e3c2f8900e284b77c784c82e2ab981"
+        assertEquals(expected, signingDataForFixture().joinToString("") { "%02x".format(it) })
+    }
+
+    @Test
+    fun minedSignatureVerifiesAndMatchesTheTransactionId() {
+        val signature = ArweaveTx.decode(field("signature"))
+        assertTrue(verifier(signingDataForFixture()).verify(signature))
+        assertEquals(field("id"), ArweaveTx.transactionId(signature))
+    }
+
+    @Test
+    fun addressIsTheModulusHashInBase64Url() {
+        val address = ArweaveTx.encode(
+            MessageDigest.getInstance("SHA-256").digest(ArweaveTx.decode(field("owner"))),
+        )
+        assertEquals(43, address.length)
+        assertTrue(ArweaveTx.isAddress(address))
+    }
+
+    @Test
+    fun tamperedSigningDataFailsVerification() {
+        val signature = ArweaveTx.decode(field("signature"))
+        val tampered = signingDataForFixture().copyOf().also { it[0] = (it[0] + 1).toByte() }
+        assertFalse(verifier(tampered).verify(signature))
+    }
+
+    @Test
+    fun amountsRoundTripBetweenArAndWinston() {
+        assertEquals("1250000000000", ArweaveTx.arToWinston("1.25").toString())
+        assertEquals("1.25", ArweaveTx.winstonToAr("1250000000000"))
+        assertEquals("0", ArweaveTx.arToWinston("0").toString())
+        assertTrue(ArweaveTx.isAddress("R5cJahCAe0yh6aBorMlQUoLFbviCLo3AvGFo3FXyW00"))
+        assertFalse(ArweaveTx.isAddress("not-an-address"))
+    }
+
+    @Test
+    fun transferBodyCarriesDecimalQuantitiesAndNoData() {
+        val body = ArweaveTx.transferBody(
+            id = "i".repeat(43),
+            owner = "o".repeat(683),
+            target = "R5cJahCAe0yh6aBorMlQUoLFbviCLo3AvGFo3FXyW00",
+            quantity = "1250000000000",
+            reward = "554288799576",
+            lastTx = "l".repeat(43),
+            signature = "s".repeat(683),
+        )
+        assertTrue(body.contains("\"format\":2"))
+        assertTrue(body.contains("\"quantity\":\"1250000000000\""))
+        assertTrue(body.contains("\"reward\":\"554288799576\""))
+        assertTrue(body.contains("\"data\":\"\""))
+        assertTrue(body.contains("\"tags\":[]"))
+    }
+}
