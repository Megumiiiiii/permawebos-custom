+package org.permaweb.andee
+
+import java.io.ByteArrayOutputStream
+import java.math.BigDecimal
+import java.math.BigInteger
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+import java.security.Signature
+import java.security.spec.MGF1ParameterSpec
+import java.security.spec.PSSParameterSpec
+import java.util.Base64
+
+/**
+ * Arweave L1 transfer signing for the node wallet.
+ *
+ * The signing data follows the v2 transaction format used by the network: a SHA-384 deep
+ * hash over [format, owner, target, quantity, reward, last_tx, tags, data_size, data_root]
+ * where the numeric fields sign their decimal strings and the others sign decoded bytes.
+ * The signature itself is RSASSA-PSS over SHA-256 with a 32-byte salt.
+ *
+ * Verified in unit tests against a signature taken from a mined mainnet transfer.
+ */
+internal object ArweaveTx {
+    const val FORMAT = 2
+    const val WINSTON_PER_AR = 1_000_000_000_000L
+    private const val SALT_LENGTH = 32
+
+    private val encoder: Base64.Encoder = Base64.getUrlEncoder().withoutPadding()
+    private val decoder: Base64.Decoder = Base64.getUrlDecoder()
+
+    fun encode(bytes: ByteArray): String = encoder.encodeToString(bytes)
+
+    fun decode(text: String): ByteArray = try {
+        decoder.decode(text)
+    } catch (_: IllegalArgumentException) {
+        ByteArray(0)
+    }
+
+    private fun utf8(value: String): ByteArray = value.toByteArray(Charsets.UTF_8)
+
+    private fun sha384(value: ByteArray): ByteArray =
+        MessageDigest.getInstance("SHA-384").digest(value)
+
+    private fun concat(vararg parts: ByteArray): ByteArray {
+        var size = 0
+        for (part in parts) size += part.size
+        val out = ByteArray(size)
+        var offset = 0
+        for (part in parts) {
+            part.copyInto(out, offset)
+            offset += part.size
+        }
+        return out
+    }
+
+    /** Blobs hash as sha384(tag || blob); lists fold their children into the tag hash. */
+    private fun deepHash(item: Any): ByteArray = when (item) {
+        is ByteArray -> {
+            val tag = concat(utf8("blob"), utf8(item.size.toString()))
+            sha384(concat(sha384(tag), sha384(item)))
+        }
+        is List<*> -> {
+            var acc = sha384(concat(utf8("list"), utf8(item.size.toString())))
+            for (child in item) {
+                acc = sha384(concat(acc, deepHash(child ?: ByteArray(0))))
+            }
+            acc
+        }
+        else -> throw IllegalArgumentException("unsupported deep hash item")
+    }
+
+    fun signingData(
+        format: Int,
+        owner: ByteArray,
+        target: ByteArray,
+        quantity: String,
+        reward: String,
+        lastTx: ByteArray,
+        tags: List<Pair<String, String>>,
+        dataSize: String,
+        dataRoot: ByteArray,
+    ): ByteArray {
+        val tagList: List<Any> = tags.map { (name, value) -> listOf(utf8(name), utf8(value)) }
+        return deepHash(
+            listOf(
+                utf8(format.toString()),
+                owner,
+                target,
+                utf8(quantity),
+                utf8(reward),
+                lastTx,
+                tagList,
+                utf8(dataSize),
+                dataRoot,
+            ),
+        )
+    }
+
+    private fun pss(): PSSParameterSpec =
+        PSSParameterSpec("SHA-256", "MGF1", MGF1ParameterSpec.SHA256, SALT_LENGTH, 1)
+
+    fun sign(wallet: ArweaveWallet, data: ByteArray): ByteArray {
+        val signature = Signature.getInstance("RSASSA-PSS")
+        signature.setParameter(pss())
+        signature.initSign(wallet.privateKey())
+        signature.update(data)
+        return signature.sign()
+    }
+
+    fun verify(wallet: ArweaveWallet, data: ByteArray, signatureBytes: ByteArray): Boolean = try {
+        val signature = Signature.getInstance("RSASSA-PSS")
+        signature.setParameter(pss())
+        signature.initVerify(wallet.publicKey())
+        signature.update(data)
+        signature.verify(signatureBytes)
+    } catch (_: Exception) {
+        false
+    }
+
+    fun transactionId(signatureBytes: ByteArray): String =
+        encode(MessageDigest.getInstance("SHA-256").digest(signatureBytes))
+
+    fun arToWinston(amount: String): BigInteger {
+        val value = BigDecimal(amount.trim())
+        require(value.signum() >= 0) { "amount must not be negative" }
+        return value.multiply(BigDecimal(WINSTON_PER_AR)).toBigIntegerExact()
+    }
+
+    fun winstonToAr(amount: String): String {
+        val value = BigDecimal(amount.trim())
+        return value.divide(BigDecimal(WINSTON_PER_AR)).stripTrailingZeros().toPlainString()
+    }
+
+    fun isAddress(value: String): Boolean =
+        value.length == 43 && value.all { it.isLetterOrDigit() || it == '-' || it == '_' }
+
+    /**
+     * Body accepted by POST /tx: decimal quantities, empty data, no tags.
+     *
+     * Built by hand so the exact wire form is unit-testable without an Android JSON runtime.
+     */
+    fun transferBody(
+        id: String,
+        owner: String,
+        target: String,
+        quantity: String,
+        reward: String,
+        lastTx: String,
+        signature: String,
+    ): String {
+        require(id.length == 43 && target.length == 43 && lastTx.isNotEmpty()) { "invalid transfer fields" }
+        require(owner.isNotEmpty() && signature.isNotEmpty()) { "invalid transfer fields" }
+        require(quantity.all { it.isDigit() } && reward.all { it.isDigit() }) { "invalid amounts" }
+        return buildString {
+            append('{')
+            append("\"format\":").append(FORMAT).append(',')
+            append("\"id\":\"").append(id).append("\",")
+            append("\"last_tx\":\"").append(lastTx).append("\",")
+            append("\"owner\":\"").append(owner).append("\",")
+            append("\"tags\":[],")
+            append("\"target\":\"").append(target).append("\",")
+            append("\"quantity\":\"").append(quantity).append("\",")
+            append("\"data\":\"\",")
+            append("\"reward\":\"").append(reward).append("\",")
+            append("\"signature\":\"").append(signature).append('"')
+            append('}')
+        }
+    }
+}
+
+/** Tiny JSON-over-HTTP client for the gateway endpoints used by the wallet screen. */
+internal object ArweaveHttp {
+    private const val CONNECT_TIMEOUT_MS = 8000
+    private const val READ_TIMEOUT_MS = 15000
+
+    class Failure(message: String) : Exception(message)
+
+    fun get(url: String): String {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        return try {
+            connection.connectTimeout = CONNECT_TIMEOUT_MS
+            connection.readTimeout = READ_TIMEOUT_MS
+            connection.setRequestProperty("accept", "application/json")
+            val code = connection.responseCode
+            if (code !in 200..299) throw Failure("HTTP $code from $url")
+            connection.inputStream.use { it.readBytes().toString(Charsets.UTF_8) }
+        } catch (e: Failure) {
+            throw e
+        } catch (e: Exception) {
+            throw Failure(e.message ?: "request failed")
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun postJson(url: String, body: String): String {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        return try {
+            connection.requestMethod = "POST"
+            connection.connectTimeout = CONNECT_TIMEOUT_MS
+            connection.readTimeout = READ_TIMEOUT_MS
+            connection.doOutput = true
+            connection.setRequestProperty("content-type", "application/json")
+            connection.setRequestProperty("accept", "application/json")
+            connection.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            val code = connection.responseCode
+            val stream = if (code in 200..299) connection.inputStream else connection.errorStream
+            val text = stream?.use { input ->
+                val out = ByteArrayOutputStream()
+                input.copyTo(out)
+                out.toString("UTF-8")
+            }.orEmpty()
+            if (code !in 200..299) throw Failure("HTTP $code: ${text.take(200)}")
+            text
+        } catch (e: Failure) {
+            throw e
+        } catch (e: Exception) {
+            throw Failure(e.message ?: "request failed")
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
