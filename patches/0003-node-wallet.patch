@@ -0,0 +1,58 @@
+package org.permaweb.andee
+
+import org.json.JSONObject
+import java.math.BigInteger
+import java.security.KeyFactory
+import java.security.MessageDigest
+import java.security.PrivateKey
+import java.security.PublicKey
+import java.security.spec.RSAPrivateCrtKeySpec
+import java.security.spec.RSAPublicKeySpec
+import java.util.Base64
+
+/**
+ * The node identity wallet (HyperBEAM key file, RSA-4096 JWK).
+ *
+ * Only read for balance display and for signing a transfer the user asked for; the key
+ * never leaves app-private storage and is never logged.
+ */
+internal class ArweaveWallet private constructor(private val jwk: JSONObject) {
+    private val decoder: Base64.Decoder = Base64.getUrlDecoder()
+    private val encoder: Base64.Encoder = Base64.getUrlEncoder().withoutPadding()
+
+    val modulusBase64Url: String = jwk.getString("n")
+
+    private fun bytes(field: String): ByteArray = decoder.decode(jwk.getString(field))
+
+    /** Arweave L1 address: base64url(sha256(modulus)). */
+    val address: String
+        get() = encoder.encodeToString(MessageDigest.getInstance("SHA-256").digest(bytes("n")))
+
+    fun privateKey(): PrivateKey = KeyFactory.getInstance("RSA").generatePrivate(
+        RSAPrivateCrtKeySpec(
+            BigInteger(1, bytes("n")),
+            BigInteger(1, bytes("e")),
+            BigInteger(1, bytes("d")),
+            BigInteger(1, bytes("p")),
+            BigInteger(1, bytes("q")),
+            BigInteger(1, bytes("dp")),
+            BigInteger(1, bytes("dq")),
+            BigInteger(1, bytes("qi")),
+        ),
+    )
+
+    fun publicKey(): PublicKey = KeyFactory.getInstance("RSA").generatePublic(
+        RSAPublicKeySpec(BigInteger(1, bytes("n")), BigInteger(1, bytes("e"))),
+    )
+
+    companion object {
+        fun fromJwk(text: String): ArweaveWallet {
+            val json = JSONObject(text)
+            require(json.optString("kty") == "RSA") { "node wallet is not an RSA JWK" }
+            for (field in listOf("n", "e", "d", "p", "q", "dp", "dq", "qi")) {
+                require(json.optString(field).isNotEmpty()) { "node wallet is missing $field" }
+            }
+            return ArweaveWallet(json)
+        }
+    }
+}
