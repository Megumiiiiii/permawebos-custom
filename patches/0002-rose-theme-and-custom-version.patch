@@ -0,0 +1,44 @@
+package org.permaweb.andee
+
+import android.graphics.Color
+
+/**
+ * Rose palette tuned to megumii.xyz (Tailwind pink + purple on a near-black plum).
+ *
+ * The ornament, setup scanner and review screens are all monospace ASCII art, so the
+ * whole look is driven from these few values instead of per-view resources.
+ */
+internal object AndeePalette {
+    /** Page background: near-black plum. */
+    val background = Color.rgb(21, 7, 16)
+
+    /** Deeper shade for wells, secondary buttons and text on accent fills. */
+    val backgroundDeep = Color.rgb(12, 3, 8)
+
+    /** Primary type: pink-100. */
+    val ink = Color.rgb(252, 231, 243)
+
+    /** Primary type with the alpha the original white ink used. */
+    val inkStrong = Color.argb(240, 252, 231, 243)
+
+    /** Secondary type. */
+    val inkMuted = Color.argb(170, 252, 231, 243)
+
+    /** Strong line-work and progress fills: pink-500. */
+    val accent = Color.rgb(236, 72, 153)
+
+    /** Glow/accent type: pink-400. */
+    val accentBright = Color.rgb(244, 114, 182)
+
+    /** Shadow glow behind the ASCII tunnel: pink-600. */
+    val glow = Color.rgb(219, 39, 119)
+
+    /** Deep pink for panel fills (adaptive icon background, rails). */
+    val panel = Color.rgb(131, 24, 67)
+
+    /** Dark modules inside the QR symbol; stays high-contrast on [ink]. */
+    val qrInk = Color.rgb(26, 7, 18)
+
+    /** Destructive/pending state fill. */
+    val warning = Color.rgb(164, 76, 0)
+}
